          <AuxValues>
            <AuxValue name="JavaCodeGenerator_CreateCodePost" type="java.lang.String" value="tblTimetable.setModel(timetableTableModel);&#xa;tblTimetable.setRowHeight(64);&#xa;tblTimetable.setShowGrid(true);&#xa;tblTimetable.setGridColor(new java.awt.Color(226, 232, 240));&#xa;tblTimetable.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION);&#xa;tblTimetable.setRowSelectionAllowed(false);&#xa;tblTimetable.setCellSelectionEnabled(false);&#xa;tblTimetable.setFocusable(false);&#xa;tblTimetable.getTableHeader().setReorderingAllowed(false);&#xa;tblTimetable.getTableHeader().setFont(new java.awt.Font(&quot;Helvetica Neue&quot;, 1, 12));&#xa;tblTimetable.getTableHeader().setBackground(new java.awt.Color(226, 232, 240));&#xa;tblTimetable.setDefaultRenderer(Object.class, new TimetableCellRenderer());&#xa;scrollPane.setViewportView(tblTimetable);"/>
          </AuxValues>
